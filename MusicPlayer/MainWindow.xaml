<Window x:Class="MusicPlayer.MainWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MusicPlayer"
        mc:Ignorable="d"
        Title="Chad player"
        Height="600"
        Width="980"
        Icon="pack://application:,,,/Assets/chad_player.ico"
        Background="#121212">
    <Window.Resources>
        <Style x:Key="NavButtonStyle"
               TargetType="Button">
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="FontSize"
                    Value="16"/>
            <Setter Property="Margin"
                    Value="5"/>
            <Setter Property="HorizontalAlignment"
                    Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- Sidebar -->
        <Grid Width="250"
              Background="#1D1D1D"
              HorizontalAlignment="Left"
              Drop="Playlists_Drop" AllowDrop="true" Name="Playlists">
            
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" Margin="10" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                <StackPanel Margin="10">
                    <!-- App Title -->
                    <TextBlock Text="Your library"
                               FontSize="24"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,10, 0, 0"
                               HorizontalAlignment="Center"/>
                    
                    <Separator Margin="20"/>

                    <!-- TreeView for Folder Structure -->
                    <TreeView ItemsSource="{Binding LeafNodes}"
                              Background="#1D1D1D"
                              Foreground="White"
                              BorderThickness="0">
                        <TreeView.ItemTemplate>
                            
                            <DataTemplate>

                                <Button Style="{StaticResource btnBlue}"
                                        Content="{Binding PlaylistName}" 
                                        Command="{Binding ButtonCommand}" 
                                        CommandParameter="{Binding Songs}" 
                                        Background="#1D1D1D" 
                                        Foreground="White" 
                                        HorizontalAlignment="Stretch" 
                                        Height="50"
                                        Width="180"
                                        FontSize="17"
                                        HorizontalContentAlignment="Center"
                                        Margin="0,0,0,10"
                                        BorderBrush="White" 
                                        BorderThickness="2" 
                                        MouseEnter="Button_MouseEnter" 
                                        MouseLeave="Button_MouseLeave" 
                                        />
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <TextBlock Text="" Margin="20"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Main Content -->
        <Grid Margin="250,0,0,50">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /> 
                <ColumnDefinition Width="0" x:Name="SidePanelColumn" />
            </Grid.ColumnDefinitions>


            <StackPanel  Orientation="Horizontal" Background="#1E1E1E" Height="50" VerticalAlignment="Top">
                <TextBlock Text="Music Files" FontSize="20" Foreground="White" FontWeight="Bold" Margin="0,10"/>
            </StackPanel>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="1" Background="#121212" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" Drop="AudioFiles_Drop" AllowDrop="true" Name="AudioFiles">

                    <!-- Scrollable List of Music Files -->
                    <ListView ItemsSource="{Binding MusicPlayerMenager.MusicFilesList}" Background="#121212" BorderBrush="Transparent" Foreground="White" Height="Auto" HorizontalAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Music File Details -->
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" Width="200" Foreground="White" VerticalAlignment="Center" Margin="5,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Artist}" Width="150" Foreground="White" VerticalAlignment="Center" Margin="5,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Duration}" Width="100" Foreground="White" VerticalAlignment="Center" Margin="5,0"/>
                                    <TextBlock Grid.Column="3" Text="" Foreground="White" VerticalAlignment="Center" Margin="5,0"/>

                                    <!-- Play Button -->
                                    <Button Style="{StaticResource playBlue}"
                                            Grid.Column="4" Content="Play" Width="80" Height="30" Margin="10,0" 
                                            Background="#00e022" Foreground="White" BorderBrush="Transparent"
                                            Command="{Binding Path=mainViewModel.MusicPlayerMenager.PlayCommand, ElementName=Root}"
                                            CommandParameter="{Binding Title}"
                                            HorizontalAlignment="Right"
                                            MouseEnter="Button_MouseEnterPlay" 
                                            MouseLeave="Button_MouseLeavePlay" 
                                    />
                                    
                                    <!-- Add lyrics button -->
                                    <Button Style="{StaticResource lyricsBlue}"
                                            Grid.Column="5" Content="📃" Width="30" Height="30" Margin="10,0" 
                                            Background="#1D1D1D" Foreground="White" BorderBrush="Transparent"
                                            Command="{Binding Path=mainViewModel.MusicPlayerMenager.AddLyricsCommand, ElementName=Root}"
                                            CommandParameter="{Binding Title}"
                                            MouseEnter="Button_MouseEnter" 
                                            MouseLeave="Button_MouseLeave"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                    />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
            
            <StackPanel Grid.Column="1" Grid.Row="0"  Orientation="Horizontal" Background="#1D1D1D" Height="50" VerticalAlignment="Top">
                <TextBlock Text="Lyrics" FontSize="22" Foreground="White" FontWeight="Bold" Margin="130, 10"/>
            </StackPanel>
            
            <Grid Grid.Column="1" Grid.Row="1" Background="#1D1D1D">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="10">
                    <TextBlock TextWrapping="Wrap" Foreground="White" FontSize="16" Text="{Binding MusicPlayerMenager.CurrentSongLyrics.Value}">
                    </TextBlock>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Grid Height="70"
              VerticalAlignment="Bottom"
              Background="#1a1a1a">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- Left (Currently Playing) -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="10">
                <Image Source="cover_placeholder.png"
                       Width="40"
                       Height="40"
                       Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="{Binding MusicPlayerMenager.CurrentSongTitle.Value}"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding MusicPlayerMenager.CurrentSongArtist.Value}"
                               Foreground="#B3B3B3"
                               FontSize="12"/>
                </StackPanel>
            </StackPanel>

            <!-- Center (Playback Controls) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                <Button Content="⏮" Width="40" Height="40" Foreground="White" Background="Transparent" BorderBrush="Transparent"
                        Command="{Binding MusicPlayerMenager.SkipBackwardCommand}"
                        VerticalAlignment="Center"/>
                <Button Content="{Binding MusicPlayerMenager.CurrentButtonSign.Value}" Width="40" Height="40" Foreground="White" Background="Transparent" BorderBrush="Transparent"
                        Command="{Binding MusicPlayerMenager.PauseResumeCommand}"
                        VerticalAlignment="Center"/>
                <Button Content="⏭" Width="40" Height="40" Foreground="White" Background="Transparent" BorderBrush="Transparent"
                        Command="{Binding MusicPlayerMenager.SkipForwardCommand}"
                        VerticalAlignment="Center"/>

            </StackPanel>

            <!-- Right (Volume Control) -->
            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="10">
                <TextBlock Text="🔊"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <Slider Maximum="100"
                        Value="50"
                        Width="100"
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Name="slVolume"
                        ValueChanged="VolumeSlider_ValueChanged"/>
            </StackPanel>
            
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="10,10,10,10">
                <Button Content="🎤" Width="30" Height="30" Foreground="White" Background="Transparent" BorderBrush="Transparent" 
                        Click="ToggleSidePanel_Click" />
            </StackPanel>
        </Grid>

        <!-- Progress Bar -->
        <ProgressBar Minimum="0" 
            Maximum="100" 
            Value="{Binding MusicPlayerMenager.CurrentSongPlayback.Value}" 
            Height="5" 
            Background="#3A3A3A" 
            Foreground="#1DB954" 
            VerticalAlignment="Bottom"
            Width="Auto"/>
    </Grid>
</Window>
